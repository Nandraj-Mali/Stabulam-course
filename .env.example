# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, keep secret

# Bunny Stream → your Video Library → API / Security
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=               # "Token authentication key" (server only)

# Your public site URL (used in certificate QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
